# ---------------------------------------------------------------------------
# Local SQLite database. In the packaged desktop app this is overridden at
# runtime to point inside the OS's per-user app-data directory (see
# apps/desktop/src-tauri/src/main.rs) — this default is for `pnpm dev` only.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./local.db"

# ---------------------------------------------------------------------------
# Where card images and user photos are stored on disk
# (packages/shared/src/local-storage.ts). Overridden at runtime in the
# packaged app the same way as DATABASE_URL above.
# ---------------------------------------------------------------------------
MEDIA_DIR="./.media"

# ---------------------------------------------------------------------------
# App data directory: the lazy card-image cache (image-cache/) and
# secrets.json (price API keys entered in Settings). The packaged app points
# this at the OS app-data folder; for `pnpm dev` it defaults to ~/.tcg-vault
# (outside the repo) when left empty.
# ---------------------------------------------------------------------------
TCG_VAULT_DATA_DIR=""
# Image cache size cap in MB (default 500). Cards in your collection are never evicted.
IMAGE_CACHE_MAX_MB=""
# Re-sync a set once its last sync is older than this many days (default 30).
CATALOG_REFRESH_DAYS=""

# ---------------------------------------------------------------------------
# Free data sources (Sprint 2+, listed now so the shape of .env is stable)
# ---------------------------------------------------------------------------
CARDTRADER_API_TOKEN=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
