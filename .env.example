# ---------------------------------------------------------------------------
# Supabase (local: values printed by `supabase start`; prod: from your project settings)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="copy-from-supabase-start-output"
SUPABASE_SERVICE_ROLE_KEY="copy-from-supabase-start-output"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="copy-from-supabase-start-output"

# Google OAuth (optional locally; required for the Google sign-in button)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Redis (BullMQ, apps/worker)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Meilisearch
# ---------------------------------------------------------------------------
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# ---------------------------------------------------------------------------
# Object storage (packages/shared/src/r2.ts is S3-compatible).
# Local dev points at the MinIO container; production points at Cloudflare R2.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_BUCKET="tcg-vault-media"
STORAGE_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# imgproxy (reads from STORAGE_* above; key/salt must match the imgproxy container).
# Generate your own with `openssl rand -hex 32` for each — the values below are
# examples only, safe for local dev, do not reuse them anywhere else.
# ---------------------------------------------------------------------------
IMGPROXY_URL="http://localhost:8080"
IMGPROXY_KEY="943b421c9eb07c830af81030552c86009268de4e532ba2ee2eab8247c6da047"
IMGPROXY_SALT="520f986b998545b4785e0defbc4f3c1203f22ba4c5a24d1e2a55b1f2e3f4a4c"

# ---------------------------------------------------------------------------
# Free data sources (Sprint 2+, listed now so the shape of .env is stable)
# ---------------------------------------------------------------------------
CARDTRADER_API_TOKEN=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
