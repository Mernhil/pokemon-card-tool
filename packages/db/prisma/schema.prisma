generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, citext]
}

// ---------- ENUMS ----------

enum Condition {
  MINT
  NEAR_MINT
  LIGHTLY_PLAYED
  MODERATELY_PLAYED
  HEAVILY_PLAYED
  DAMAGED
}

enum Finish {
  NON_FOIL
  HOLO // standard holo window
  REVERSE_HOLO // foil outside the art box
  COSMOS_HOLO
  CRACKED_ICE
  FULL_ART_TEXTURED
  RAINBOW
  GOLD
  ETCHED
  PARALLEL // One Piece parallel / alt art foil
  SECRET_TEXTURED // YGO Secret Rare diagonal texture
  ULTIMATE // YGO Ultimate Rare embossed
  GHOST
  STARLIGHT
  QUARTER_CENTURY
  PRISMATIC
  OTHER
}

enum Edition {
  UNLIMITED
  FIRST_EDITION
  SHADOWLESS
  LIMITED
  PROMO
  STAFF
  PRERELEASE
}

enum GradingCompany {
  PSA
  BGS
  CGC
  SGC
  TAG
  ACE
  OTHER
}

enum SetType {
  MAIN
  EXPANSION
  SPECIAL
  STARTER_DECK
  PROMO
  TIN_OR_COLLECTION
  TOURNAMENT
}

enum PriceSourceKind {
  CARDMARKET
  CARDTRADER
  TCGPLAYER
  EBAY_SOLD
  AGGREGATOR
  MANUAL
}

enum Marketplace {
  CARDMARKET
  CARDTRADER
  EBAY
  TCGPLAYER
}

// ---------- CATALOG ----------

model Game {
  id       Int      @id @default(autoincrement())
  slug     String   @unique // "pokemon", "yugioh", "one-piece"
  name     String
  sets     Set[]
  cards    Card[]
  rarities Rarity[]
  createdAt DateTime @default(now())
}

model Language {
  code     String         @id // BCP-47: en, ja, fr, de, it, es, pt, ko, zh-Hans, zh-Hant
  name     String
  variants PrintVariant[]
  sets     Set[]
}

model Set {
  id              Int           @id @default(autoincrement())
  gameId          Int
  game            Game          @relation(fields: [gameId], references: [id])
  code            String // "sv8", "OP09", "ROTA"
  name            String
  series          String? // "Scarlet & Violet", "Duelist Pack"
  type            SetType       @default(MAIN)
  primaryLangCode String?
  primaryLang     Language?     @relation(fields: [primaryLangCode], references: [code])
  releaseDate     DateTime?     @db.Date
  printedTotal    Int? // number printed on cards ("/191")
  totalCards      Int? // incl. secret rares
  logoUrl         String?
  symbolUrl       String?
  printings       Printing[]
  externalRefs    ExternalRef[]
  updatedAt       DateTime      @updatedAt

  @@unique([gameId, code])
  @@index([gameId, releaseDate])
}

model Rarity {
  id            Int        @id @default(autoincrement())
  gameId        Int
  game          Game       @relation(fields: [gameId], references: [id])
  name          String // "Special Illustration Rare", "Secret Rare", "SEC"
  code          String?
  sortOrder     Int        @default(0) // for rarity breakdown charts
  defaultFinish Finish     @default(NON_FOIL)
  printings     Printing[]

  @@unique([gameId, name])
}

model Artist {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.Citext
  printings Printing[]
}

/// Gameplay identity, shared across reprints.
model Card {
  id           String        @id @default(cuid())
  gameId       Int
  game         Game          @relation(fields: [gameId], references: [id])
  name         String
  cardType     String // Pokemon/Trainer/Energy, Monster/Spell/Trap, Leader/Character/Event/Stage/DON!!
  subtypes     String[] // ["Stage 2","ex"], ["Effect","Synchro"], ["Straw Hat Crew"]
  rulesText    String?
  flavorText   String?
  attributes   Json          @default("{}") // hp, types, atk, def, level, cost, power, counter, color...
  canonicalKey String // YGO passcode, OP card id, Pokemon hash(name+text)
  printings    Printing[]
  externalRefs ExternalRef[]
  updatedAt    DateTime      @updatedAt

  @@unique([gameId, canonicalKey])
  @@index([gameId, name])
  @@index([gameId, cardType])
}

/// A card as it appears in one set: number, art, rarity, artist.
model Printing {
  id              String         @id @default(cuid())
  cardId          String
  card            Card           @relation(fields: [cardId], references: [id])
  setId           Int
  set             Set            @relation(fields: [setId], references: [id])
  collectorNumber String // "199/191", "OP09-118", "ROTA-EN024"
  sortNumber      Int // numeric part for ordering
  rarityId        Int?
  rarity          Rarity?        @relation(fields: [rarityId], references: [id])
  artistId        Int?
  artist          Artist?        @relation(fields: [artistId], references: [id])
  isAltArt        Boolean        @default(false)
  imageKey        String? // R2 object key of the master HD scan
  imageWidth      Int?
  imageHeight     Int?
  variants        PrintVariant[]
  externalRefs    ExternalRef[]

  @@unique([setId, collectorNumber, isAltArt])
  @@index([cardId])
  @@index([rarityId])
}

/// The ownable, priceable object.
model PrintVariant {
  id            String               @id @default(cuid())
  printingId    String
  printing      Printing             @relation(fields: [printingId], references: [id])
  finish        Finish               @default(NON_FOIL)
  edition       Edition              @default(UNLIMITED)
  languageCode  String
  language      Language             @relation(fields: [languageCode], references: [code])
  foilProfileId Int?
  foilProfile   FoilProfile?         @relation(fields: [foilProfileId], references: [id])
  imageKey      String? // override when the variant looks different (e.g. stamped promo)
  collection    CollectionItem[]
  priceObs      PriceObservation[]
  sales         SaleRecord[]
  valuations    VariantValuation[]
  mappings      MarketplaceMapping[]

  @@unique([printingId, finish, edition, languageCode])
  @@index([languageCode])
}

/// Drives the 3D viewer: which shader preset + texture masks to use.
model FoilProfile {
  id           Int            @id @default(autoincrement())
  slug         String         @unique // "pkm-sv-sir", "ygo-secret", "op-parallel"
  shader       String // shader preset name in /packages/card-fx
  params       Json           @default("{}") // intensity, hue spread, grain scale, sparkle density...
  foilMaskKey  String? // R2 key: where foil is applied
  normalMapKey String? // R2 key: embossing / texture relief
  variants     PrintVariant[]
}

/// Upstream IDs so syncs are idempotent upserts.
model ExternalRef {
  id         Int       @id @default(autoincrement())
  source     String // "pokemontcg", "ygoprodeck", "optcg", "cardmarket", "tcgplayer"
  externalId String
  setId      Int?
  set        Set?      @relation(fields: [setId], references: [id])
  cardId     String?
  card       Card?     @relation(fields: [cardId], references: [id])
  printingId String?
  printing   Printing? @relation(fields: [printingId], references: [id])

  @@unique([source, externalId])
}

// ---------- USERS & INVENTORY ----------

/// id matches auth.users.id (Supabase). Rows are created by the
/// on_auth_user_created trigger defined in migration 0002, not by app code.
model User {
  id              String              @id
  handle          String              @unique @db.Citext
  displayCurrency String              @default("EUR")
  createdAt       DateTime            @default(now())
  items           CollectionItem[]
  binders         Binder[]
  snapshots       PortfolioSnapshot[]
}

/// One physical card (or an identical stack, via quantity) the user owns.
model CollectionItem {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId        String
  variant          PrintVariant    @relation(fields: [variantId], references: [id])
  quantity         Int             @default(1)
  condition        Condition? // null when graded
  gradingCompany   GradingCompany?
  grade            Decimal?        @db.Decimal(3, 1) // 10, 9.5, 8.5...
  certNumber       String?
  purchasePrice    Int? // minor units
  purchaseCurrency String?
  acquiredAt       DateTime?       @db.Date
  notes            String?
  photoKeys        String[] // user photos of their copy
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  binderSlots      BinderSlot[]

  @@unique([gradingCompany, certNumber])
  @@index([userId, variantId])
}

model Binder {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  coverKey  String?
  rows      Int          @default(3) // 3x3 = 9-pocket, 4x3 = 12-pocket
  cols      Int          @default(3)
  isPublic  Boolean      @default(false)
  sortOrder Int          @default(0)
  pages     BinderPage[]
  createdAt DateTime     @default(now())
}

model BinderPage {
  id        String       @id @default(cuid())
  binderId  String
  binder    Binder       @relation(fields: [binderId], references: [id], onDelete: Cascade)
  pageIndex Int
  slots     BinderSlot[]

  @@unique([binderId, pageIndex])
}

model BinderSlot {
  id                    String          @id @default(cuid())
  pageId                String
  page                  BinderPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  position              Int // 0 .. rows*cols-1
  collectionItemId      String?
  collectionItem        CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)
  placeholderVariantId  String? // "want" slot: shows a greyed-out card

  @@unique([pageId, position])
}

// ---------- PRICING ----------

model MarketplaceMapping {
  id          Int          @id @default(autoincrement())
  variantId   String
  variant     PrintVariant @relation(fields: [variantId], references: [id])
  marketplace Marketplace
  productId   String // Cardmarket idProduct, CardTrader blueprint id, eBay EPID
  url         String?
  confidence  Float        @default(1) // < 1 when matched heuristically

  @@unique([variantId, marketplace])
}

/// Raw, append-only observations. Range-partitioned by month on observedAt
/// (see migration 0002) — observedAt must stay part of the primary key
/// because Postgres requires the partition key in every unique constraint.
model PriceObservation {
  id             BigInt          @default(autoincrement())
  variantId      String
  variant        PrintVariant    @relation(fields: [variantId], references: [id])
  source         PriceSourceKind
  condition      Condition? // null = source doesn't split by condition
  gradingCompany GradingCompany?
  grade          Decimal?        @db.Decimal(3, 1)
  currency       String
  low            Int?
  mid            Int?
  market         Int?
  trend          Int?
  sampleSize     Int?
  observedAt     DateTime

  @@id([id, observedAt])
  @@index([variantId, observedAt(sort: Desc)])
}

/// Individual completed sales (eBay sold, CardTrader completed orders).
model SaleRecord {
  id             BigInt          @id @default(autoincrement())
  variantId      String
  variant        PrintVariant    @relation(fields: [variantId], references: [id])
  source         PriceSourceKind
  externalId     String
  title          String
  condition      Condition?
  gradingCompany GradingCompany?
  grade          Decimal?        @db.Decimal(3, 1)
  price          Int
  shipping       Int?
  currency       String
  soldAt         DateTime
  url            String?
  matchScore     Float // title-matching confidence

  @@unique([source, externalId])
  @@index([variantId, soldAt(sort: Desc)])
}

/// Derived daily value per variant x condition/grade, in EUR and USD.
model VariantValuation {
  variantId  String
  variant    PrintVariant @relation(fields: [variantId], references: [id])
  day        DateTime     @db.Date
  bucket     String // "NM", "LP", "PSA10", "BGS9.5"
  valueEur   Int
  valueUsd   Int
  confidence Float

  @@id([variantId, day, bucket])
}

model PortfolioSnapshot {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  currency   String
  totalValue Int
  costBasis  Int?
  itemCount  Int
  breakdown  Json // by game, set, rarity for the dashboard

  @@id([userId, day])
}
