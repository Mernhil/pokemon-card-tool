generator client {
  provider      = "prisma-client-js"
  // "native" covers dev/CI on whatever OS is running; "windows" is required
  // for the packaged desktop app since the Tauri sidecar always runs on
  // Windows there regardless of what OS built the repo.
  binaryTargets = ["native", "windows"]
}

// Local-only desktop build: one SQLite file per install, no server, no auth.
// (The original cloud plan used Postgres + Supabase RLS; see git history /
// the architecture doc if this ever needs to grow back into a hosted app.)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- "ENUMS" ----------
// SQLite's Prisma connector has no enum support at all (unlike Postgres/MySQL),
// so every field that would have been an enum is a plain String below. The
// actual value sets live as TS union types in packages/shared/src/enums.ts —
// import CONDITIONS / FINISHES / etc. from there for validation and <select> options.

// ---------- CATALOG ----------

model Game {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // "pokemon", "yugioh", "one-piece"
  name      String
  sets      Set[]
  cards     Card[]
  rarities  Rarity[]
  createdAt DateTime @default(now())
}

model Language {
  code     String         @id // BCP-47: en, ja, fr, de, it, es, pt, ko, zh-Hans, zh-Hant
  name     String
  variants PrintVariant[]
  sets     Set[]
}

model Set {
  id              Int           @id @default(autoincrement())
  gameId          Int
  game            Game          @relation(fields: [gameId], references: [id])
  code            String // "sv8", "OP09", "ROTA"
  name            String
  series          String? // "Scarlet & Violet", "Duelist Pack"
  type            String        @default("MAIN") // SetType, see packages/shared/src/enums.ts
  /// SetCategory (packages/shared/src/set-category.ts): main | promo | mcdonalds |
  /// trainer-kit | pocket | other. Set by the catalog sync via classifySet().
  category        String        @default("main")
  primaryLangCode String?
  primaryLang     Language?     @relation(fields: [primaryLangCode], references: [code])
  releaseDate     DateTime?
  printedTotal    Int? // number printed on cards ("/191")
  totalCards      Int? // incl. secret rares
  logoUrl         String?
  symbolUrl       String?
  printings       Printing[]
  externalRefs    ExternalRef[]
  binders         Binder[]
  updatedAt       DateTime      @updatedAt

  @@unique([gameId, code])
  @@index([gameId, releaseDate])
  @@index([gameId, category])
}

model Rarity {
  id            Int        @id @default(autoincrement())
  gameId        Int
  game          Game       @relation(fields: [gameId], references: [id])
  name          String // "Special Illustration Rare", "Secret Rare", "SEC"
  code          String?
  sortOrder     Int        @default(0) // for rarity breakdown charts
  defaultFinish String     @default("NON_FOIL") // Finish, see packages/shared/src/enums.ts
  printings     Printing[]

  @@unique([gameId, name])
}

model Artist {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  printings Printing[]
}

/// Gameplay identity, shared across reprints.
model Card {
  id           String        @id @default(cuid())
  gameId       Int
  game         Game          @relation(fields: [gameId], references: [id])
  name         String
  cardType     String // Pokemon/Trainer/Energy, Monster/Spell/Trap, Leader/Character/Event/Stage/DON!!
  subtypes     String        @default("[]") // JSON-encoded string[]: ["Stage 2","ex"], ["Effect","Synchro"]
  rulesText    String?
  flavorText   String?
  attributes   String        @default("{}") // JSON-encoded object: hp, types, atk, def, level, cost, power...
  canonicalKey String // YGO passcode, OP card id, Pokemon hash(name+text)
  printings    Printing[]
  externalRefs ExternalRef[]
  /// National Pokédex ids (Pokémon only), normalized out of attributes.dexId for indexed lookups.
  dex          CardDex[]
  updatedAt    DateTime      @updatedAt

  @@unique([gameId, canonicalKey])
  @@index([gameId, name])
  @@index([gameId, cardType])
}

/// One National Pokédex id of a Pokémon card (a tag-team card has several): the indexed way to
/// find "all cards of Jirachi" without matching names. Filled by the catalog sync and backfilled
/// at startup from Card.attributes (packages/db/src/dex.ts).
model CardDex {
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  dexId  Int

  @@id([cardId, dexId])
  @@index([dexId])
}

/// A card as it appears in one set: number, art, rarity, artist.
model Printing {
  id              String         @id @default(cuid())
  cardId          String
  card            Card           @relation(fields: [cardId], references: [id])
  setId           Int
  set             Set            @relation(fields: [setId], references: [id])
  collectorNumber String // "199/191", "OP09-118", "ROTA-EN024"
  sortNumber      Int // numeric part for ordering
  rarityId        Int?
  rarity          Rarity?        @relation(fields: [rarityId], references: [id])
  artistId        Int?
  artist          Artist?        @relation(fields: [artistId], references: [id])
  isAltArt        Boolean        @default(false)
  imageKey        String? // local storage key of the master HD scan (see packages/shared/src/local-storage.ts)
  /// JSON-encoded string[]: remote scan URLs, best first. The media route
  /// fetches these on first view into the image cache (packages/db/src/image-cache.ts).
  imageUrls       String?
  imageWidth      Int?
  imageHeight     Int?
  /// A scan the user supplied ("Set custom image"): a storage key under media/custom/.
  /// Wins over every remote source and is never touched by a catalog re-sync.
  customImageKey  String?
  /// Sub-collection inside the set ("Special Art", "Classic Collection"); see
  /// packages/shared/src/subsets.ts. Null for sets without subsets.
  subset          String?
  variants        PrintVariant[]
  externalRefs    ExternalRef[]
  wishlist        WishlistItem?

  @@unique([setId, collectorNumber, isAltArt])
  @@index([setId, subset])
  @@index([cardId])
  @@index([rarityId])
}

/// The ownable, priceable object.
model PrintVariant {
  id            String               @id @default(cuid())
  printingId    String
  printing      Printing             @relation(fields: [printingId], references: [id])
  finish        String               @default("NON_FOIL") // Finish, see packages/shared/src/enums.ts
  edition       String               @default("UNLIMITED") // Edition, see packages/shared/src/enums.ts
  languageCode  String
  language      Language             @relation(fields: [languageCode], references: [code])
  foilProfileId Int?
  foilProfile   FoilProfile?         @relation(fields: [foilProfileId], references: [id])
  imageKey      String? // override when the variant looks different (e.g. stamped promo)
  collection    CollectionItem[]
  priceObs      PriceObservation[]
  sales         SaleRecord[]
  valuations    VariantValuation[]
  mappings      MarketplaceMapping[]
  providerMaps  ProviderMapping[]
  alerts        PriceAlert[]
  gradedPrices  GradedPrice[]

  @@unique([printingId, finish, edition, languageCode])
  @@index([languageCode])
}

/// Drives the 3D viewer: which shader preset + texture masks to use.
model FoilProfile {
  id           Int            @id @default(autoincrement())
  slug         String         @unique // "pkm-sv-sir", "ygo-secret", "op-parallel"
  shader       String // shader preset name in /packages/card-fx
  params       String         @default("{}") // JSON-encoded FoilPresetParams (see packages/card-fx)
  foilMaskKey  String? // local storage key: where foil is applied
  normalMapKey String? // local storage key: embossing / texture relief
  variants     PrintVariant[]
}

/// Upstream IDs so syncs are idempotent upserts.
model ExternalRef {
  id         Int       @id @default(autoincrement())
  source     String // "pokemontcg", "ygoprodeck", "optcg", "cardmarket", "tcgplayer"
  externalId String
  setId      Int?
  set        Set?      @relation(fields: [setId], references: [id])
  cardId     String?
  card       Card?     @relation(fields: [cardId], references: [id])
  printingId String?
  printing   Printing? @relation(fields: [printingId], references: [id])

  @@unique([source, externalId])
}

// ---------- INVENTORY ----------
// No User/auth model: this is a single-profile local app. Everything below
// hangs directly off the one local collection.

/// One physical card (or an identical stack, via quantity) the user owns.
model CollectionItem {
  id               String       @id @default(cuid())
  variantId        String
  variant          PrintVariant @relation(fields: [variantId], references: [id])
  quantity         Int          @default(1)
  condition        String? // Condition, null when graded — see packages/shared/src/enums.ts
  gradingCompany   String? // GradingCompany — see packages/shared/src/enums.ts
  grade            Float? // 10, 9.5, 8.5...
  certNumber       String?
  purchasePrice    Int? // minor units, per card (not per stack)
  purchaseCurrency String?
  acquiredAt       DateTime?
  notes            String?
  photoKeys        String       @default("[]") // JSON-encoded string[]: user photos of their copy
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  binderSlots      BinderSlot[]

  @@unique([gradingCompany, certNumber])
  @@index([variantId])
}

/// A card the user wants but doesn't own yet (per printing, any finish).
model WishlistItem {
  id         String   @id @default(cuid())
  printingId String   @unique
  printing   Printing @relation(fields: [printingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

/// A saved search with a progress bar: "all Charizards", "every Special Illustration Rare".
/// `filter` is the JSON of GoalFilter (packages/db/src/goals.ts); progress is how many of the
/// matching cards the user owns, computed on demand.
model Goal {
  id        String   @id @default(cuid())
  name      String
  filter    String // JSON-encoded GoalFilter
  createdAt DateTime @default(now())
}

model Binder {
  id        String       @id @default(cuid())
  name      String
  coverKey  String?
  color     String       @default("#5b1f2b") // cover "leather" colour, CSS hex
  rows      Int          @default(3) // 3x3 = 9-pocket, 4x3 = 12-pocket
  cols      Int          @default(3)
  sortOrder Int          @default(0)
  /// Set this binder was generated from ("binder from a set"), if any.
  setId     Int?
  set       Set?         @relation(fields: [setId], references: [id], onDelete: SetNull)
  pages     BinderPage[]
  createdAt DateTime     @default(now())
}

model BinderPage {
  id        String       @id @default(cuid())
  binderId  String
  binder    Binder       @relation(fields: [binderId], references: [id], onDelete: Cascade)
  pageIndex Int
  slots     BinderSlot[]

  @@unique([binderId, pageIndex])
}

model BinderSlot {
  id                   String          @id @default(cuid())
  pageId               String
  page                 BinderPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  position             Int // 0 .. rows*cols-1
  /// The owned copy sitting in this pocket (one card of the item's quantity).
  collectionItemId     String?
  collectionItem       CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)
  /// The card this pocket is *for* ("want"): shown greyed out while empty, and
  /// kept when the owned copy is taken out. Independent of collectionItemId.
  placeholderVariantId String?

  @@unique([pageId, position])
}

// ---------- PRICING ----------

/// @deprecated Never written; superseded by ProviderMapping (whose external id
/// can be empty for search-based providers). Kept so no migration has to
/// rebuild or drop a table.
model MarketplaceMapping {
  id          Int          @id @default(autoincrement())
  variantId   String
  variant     PrintVariant @relation(fields: [variantId], references: [id])
  marketplace String // Marketplace, see packages/shared/src/enums.ts
  productId   String // Cardmarket idProduct, CardTrader blueprint id, eBay EPID
  url         String?
  confidence  Float        @default(1) // < 1 when matched heuristically

  @@unique([variantId, marketplace])
}

/// Our variant <-> one price provider's identifier for it. Resolved
/// automatically by the provider adapter (packages/sources/src/pricing), or
/// set by hand (manualOverride) from the card page's "Wrong match?" form.
model ProviderMapping {
  id             Int          @id @default(autoincrement())
  variantId      String
  variant        PrintVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  provider       String // PriceProviderId, see packages/shared/src/enums.ts
  /// CardTrader blueprint id, Cardmarket idProduct, TCGplayer productId, eBay EPID.
  externalId     String?
  /// Search query, for search-based providers (eBay).
  query          String?
  url            String?
  /// 0..1: how sure the automatic match is. Below 0.8 it's "low_confidence":
  /// shown with a warning and left out of valuations and "Best value".
  confidence     Float        @default(0)
  status         String       @default("matched") // MappingStatus: matched | low_confidence | not_found
  manualOverride Boolean      @default(false) // set by the user; never re-resolved automatically
  notes          String? // why it matched (or didn't), shown on the card page
  resolvedAt     DateTime     @default(now())

  @@unique([variantId, provider])
  @@index([provider, status])
}

/// Raw, append-only observations. Since the pricing pipeline, each row is
/// one number: `provider` + `kind` + `amount` (+ condition, listing count).
/// Older rows (kind = null) carry low/mid/market/trend instead and are read
/// through normalizeObservation() in packages/db/src/prices.ts.
model PriceObservation {
  id             Int          @id @default(autoincrement())
  variantId      String
  variant        PrintVariant @relation(fields: [variantId], references: [id])
  source         String // PriceSourceKind, see packages/shared/src/enums.ts
  /// PriceProviderId: cardmarket | tcgplayer | cardtrader | ebay
  provider       String?
  /// PriceKind: sold | asking | market_average | trend | lowest_listing
  kind           String?
  /// Minor units of `currency` (cents; whole yen for JPY).
  amount         Int?
  condition      String? // Condition, null = source doesn't split by condition
  gradingCompany String? // GradingCompany
  grade          Float?
  currency       String
  low            Int?
  mid            Int?
  market         Int?
  trend          Int?
  sampleSize     Int?
  /// Listings (asking/lowest_listing) or sales (sold) the number is based on, if known.
  listingCount   Int?
  /// Language the number is for (PRICE_LANGUAGES). Null = the source can't split by
  /// language (Cardmarket, TCGplayer via TCGdex) or the listing didn't say.
  languageCode   String?
  /// sha256 of the provider response this came from, to trace odd numbers back.
  payloadHash    String?
  observedAt     DateTime

  @@index([variantId, observedAt(sort: Desc)])
  @@index([variantId, provider, observedAt(sort: Desc)])
}

/// Individual completed sales (eBay sold, CardTrader completed orders).
model SaleRecord {
  id             Int          @id @default(autoincrement())
  variantId      String
  variant        PrintVariant @relation(fields: [variantId], references: [id])
  source         String // PriceSourceKind, see packages/shared/src/enums.ts
  externalId     String
  title          String
  condition      String? // Condition
  gradingCompany String? // GradingCompany
  grade          Float?
  price          Int
  shipping       Int?
  currency       String
  soldAt         DateTime
  url            String?
  matchScore     Float // title-matching confidence

  @@unique([source, externalId])
  @@index([variantId, soldAt(sort: Desc)])
}

/// Derived daily value per variant x condition/grade, in EUR and USD.
model VariantValuation {
  variantId  String
  variant    PrintVariant @relation(fields: [variantId], references: [id])
  day        DateTime
  bucket     String // "NM", "LP", "PSA10", "BGS9.5"
  valueEur   Int
  valueUsd   Int
  confidence Float

  @@id([variantId, day, bucket])
}

model PortfolioSnapshot {
  day        DateTime @id
  currency   String
  totalValue Int
  costBasis  Int?
  itemCount  Int
  breakdown  String // JSON-encoded object: by game, set, rarity for the dashboard
}

// ---------- BACKGROUND JOBS ----------

/// Per-item state for every background job (packages/db/src/jobs/runner.ts):
/// catalog sync (job "catalog", itemKey = set code) and price refresh
/// (job "price:<provider>", itemKey = PrintVariant id). One row per item,
/// so a run can stop anywhere and the next one picks up where it left off.
model SyncState {
  id            Int       @id @default(autoincrement())
  job           String // "catalog", "price:cardtrader", "fx"
  game          String // Game.slug ("pokemon"), or "*" for game-independent jobs
  itemKey       String // set code, variant id, ...
  label         String? // human-readable name for progress UI ("Shrouded Fable")
  status        String    @default("pending") // SyncStatus: pending | syncing | done | failed
  priority      Int       @default(0) // higher runs first
  lastSyncedAt  DateTime?
  lastAttemptAt DateTime?
  attemptCount  Int       @default(0) // failed attempts since the last success
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([job, game, itemKey])
  @@index([job, game, status])
}

/// Cross-process mutex for a job run (the CLI and the app share one DB).
/// Held rows are refreshed by a heartbeat; a stale heartbeat means the holder died.
model JobLock {
  name        String   @id
  holder      String
  acquiredAt  DateTime
  heartbeatAt DateTime
}

/// One card scan in the on-disk image cache (packages/db/src/image-cache.ts).
/// Tracked here rather than via file access times, which Windows often doesn't update.
model ImageCacheEntry {
  key            String   @id // file name inside the cache directory
  printingId     String?
  bytes          Int
  contentType    String
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@index([lastAccessedAt])
  @@index([printingId])
}

/// Health of each price provider, for Settings and the card page's panels.
model ProviderStatus {
  provider         String    @id // PriceProviderId
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastError        String?
  rateLimitedUntil DateTime?
  updatedAt        DateTime  @updatedAt
}

/// Non-secret app settings (display currency, refresh cadence, enabled
/// providers) as JSON values. API keys are NOT here: they live in
/// secrets.json in the app data directory (packages/db/src/settings.ts).
model AppSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

/// Last time each card page was opened: "recently viewed" cards get their
/// prices refreshed after the collection's.
model CardView {
  printingId   String   @id
  lastViewedAt DateTime
  viewCount    Int      @default(1)

  @@index([lastViewedAt])
}

/// Exchange rates as units of `currency` per 1 EUR (the ECB's convention),
/// refreshed daily in the background. Built-in approximate rates
/// (packages/shared/src/currency.ts) cover the time before the first fetch.
model ExchangeRate {
  currency String   @id
  perEur   Float
  asOf     DateTime
  source   String // "ecb"
}

/// "Tell me when this card's value goes above / below X". Checked after every
/// valuation run (packages/db/src/alerts.ts); once crossed it stays triggered
/// until the user dismisses (deletes) it.
model PriceAlert {
  id                String       @id @default(cuid())
  variantId         String
  variant           PrintVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  direction         String // "ABOVE" | "BELOW"
  thresholdEur      Int // EUR minor units, per card
  createdAt         DateTime     @default(now())
  triggeredAt       DateTime?
  triggeredValueEur Int?

  @@index([variantId])
}

/// Asking prices of graded slabs (eBay), per grading company and grade, for one
/// variant. Replaced wholesale on each refresh; see packages/db/src/graded.ts.
model GradedPrice {
  id           String       @id @default(cuid())
  variantId    String
  variant      PrintVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  company      String // GradingCompanyId: PSA, BGS, CGC, SGC, TAG, ACE
  gradeKey     String // "10", "10:pristine", "10:black-label", "9.5"
  currency     String
  median       Int // minor units of `currency`
  low          Int
  listingCount Int
  languageCode String
  observedAt   DateTime

  @@unique([variantId, languageCode, company, gradeKey, currency])
  @@index([variantId])
}
