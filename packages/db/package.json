{
  "name": "@tcg-vault/db",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "sync-catalog": "dotenv -e ../../.env -- tsx src/sync-catalog.ts",
    "validate": "prisma validate",
    "postinstall": "prisma generate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "sync-prices": "dotenv -e ../../.env -- tsx src/sync-prices.ts",
    "image-report": "dotenv -e ../../.env -- tsx src/image-report.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "seed-demo": "dotenv -e ../../.env -- tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@tcg-vault/pricing": "workspace:*",
    "@tcg-vault/shared": "workspace:*",
    "@tcg-vault/sources": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^20.16.11",
    "dotenv-cli": "^7.4.2",
    "prisma": "^7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
