{
  "name": "@tcg-vault/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "sync-catalog": "dotenv -e ../../.env -- tsx src/sync-catalog.ts",
    "validate": "prisma validate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "sync-prices": "dotenv -e ../../.env -- tsx src/sync-prices.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tcg-vault/pricing": "workspace:*",
    "@tcg-vault/shared": "workspace:*",
    "@tcg-vault/sources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
