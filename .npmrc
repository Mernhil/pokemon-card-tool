# Windows NSIS bundling (apps/desktop) fails to read files whose absolute
# path exceeds ~260 characters. pnpm's default "isolated" node_modules layout
# nests packages under node_modules/.pnpm/<name>@<version>_<peer-hash>/node_modules/<name>/...,
# and Next.js's standalone output tracing mirrors that structure — with
# peer-dependency-suffixed folder names (e.g. next@14.2.15_react-dom@18.3.1_react@18.3.1__react@18.3.1)
# this routinely pushes deeply nested files (like Next's webpack plugins)
# past the Windows path limit. Hoisted linking keeps node_modules flat
# (node_modules/<name>/...) so bundled paths stay well within the limit.
node-linker=hoisted
