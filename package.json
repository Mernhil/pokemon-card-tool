{
  "name": "tcg-vault",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tcg-vault/db run generate",
    "db:migrate": "pnpm --filter @tcg-vault/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @tcg-vault/db run migrate:dev",
    "db:seed": "pnpm --filter @tcg-vault/db run seed",
    "db:sync-catalog": "pnpm --filter @tcg-vault/db run sync-catalog",
    "db:validate": "pnpm --filter @tcg-vault/db run validate",
    "db:sync-prices": "pnpm --filter @tcg-vault/db run sync-prices"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3"
  }
}
